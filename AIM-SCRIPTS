local MIN_STRENGTH, MAX_STRENGTH = 0.05, 1

local function setStrengthAlpha(a)
	a = math.clamp(a, 0, 1)
	CONFIG.Strength = MIN_STRENGTH + a * (MAX_STRENGTH - MIN_STRENGTH)
	sliderFill.Size = UDim2.new(a, 0, 1, 0)
	sliderLabel.Text = "Сила помощи прицелу: " .. math.floor(a * 100 + 0.5) .. "%"
end

local function sliderFromX(x)
	local width = sliderBack.AbsoluteSize.X
	if width <= 0 then
		return
	end
	setStrengthAlpha((x - sliderBack.AbsolutePosition.X) / width)
end

setStrengthAlpha((CONFIG.Strength - MIN_STRENGTH) / (MAX_STRENGTH - MIN_STRENGTH))

local dragging = false

sliderBack.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		sliderFromX(input.Position.X)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		sliderFromX(input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

local collapsed = false
collapseBtn.MouseButton1Click:Connect(function()
	collapsed = not collapsed
	collapseBtn.Text = collapsed and "+" or "-"
	sliderLabel.Visible = not collapsed
	sliderBack.Visible = not collapsed
	panel.Size = UDim2.new(0, PANEL_W, 0, collapsed and SHORT_H or FULL_H)
end)

local function updateHUD(now)
	if active then
		local left = math.max(activeUntil - now, 0)
		status.Text = "Разведка [T]: активна " .. math.ceil(left) .. " с"
		bar.Size = UDim2.new(math.clamp(left / CONFIG.Duration, 0, 1), 0, 1, 0)
		bar.BackgroundColor3 = Color3.fromRGB(46, 160, 67)
	elseif now < readyAt then
		local left = readyAt - now
		status.Text = "Разведка [T]: перезарядка " .. math.ceil(left) .. " с"
		bar.Size = UDim2.new(1 - math.clamp(left / CONFIG.Cooldown, 0, 1), 0, 1, 0)
		bar.BackgroundColor3 = Color3.fromRGB(220, 140, 40)
	else
		status.Text = "Разведка [T]: готова"
		bar.Size = UDim2.new(1, 0, 1, 0)
		bar.BackgroundColor3 = Color3.fromRGB(80, 140, 255)
	end
end

----------------------------------------------------------------
-- Запуск способности
----------------------------------------------------------------
local function startAbility()
	if active or os.clock() < readyAt then
		return
	end
	active = true
	activeUntil = os.clock() + CONFIG.Duration
	updateHighlights()
end

local function endAbility()
	active = false
	readyAt = os.clock() + CONFIG.Cooldown
	updateHighlights()
end

status.MouseButton1Click:Connect(startAbility)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end
	if input.KeyCode == CONFIG.Key then
		startAbility()
	end
end)

RunService:BindToRenderStep("ScoutAssistStep", Enum.RenderPriority.Last.Value, function(dt)
	local now = os.clock()
	if active and now >= activeUntil then
		endAbility()
	end
	updateHUD(now)

	if not active then
		return
	end

	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end

	local target = findAssistTarget(cam)
	if not target then
		return
	end

	-- мягкое подтягивание: максимум 20% угла за кадр при силе 100%
	local maxPull = CONFIG.Strength * 0.2
	local alpha = 1 - (1 - maxPull) ^ (math.clamp(dt, 0, 0.1) * 60)
	local goal = CFrame.lookAt(cam.CFrame.Position, target.Position)
	cam.CFrame = cam.CFrame:Lerp(goal, alpha)
end)
