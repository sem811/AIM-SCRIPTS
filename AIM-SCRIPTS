local HLNAME = "_SemyonGlow"

local function updateGlow(m, isNPC, plrName)
    if not m or not m.Parent then return end
    local old = m:FindFirstChild(HLNAME)
    local hum = m:FindFirstChildOfClass("Humanoid")
    if not S.EspGlow or not hum or hum.Health <= 0 then
        if old then old:Destroy() end
        return
    end
    local col = isNPC and rgb(255,150,40) or rgb(255,50,50)
    if old then old.FillColor = col old.OutlineColor = col return end
    local hl = Instance.new("Highlight")
    hl.Name = HLNAME
    hl.FillColor = col hl.OutlineColor = col
    hl.FillTransparency = 0.55 hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = m
end

local function hookPlr(plr)
    if plr == LocalPlayer then return end
    if plr.Character then task.spawn(updateGlow, plr.Character, false) end
    plr.CharacterAdded:Connect(function()
        task.wait(0.6)
        task.spawn(updateGlow, plr.Character, false)
    end)
end
for _, p in ipairs(Players:GetPlayers()) do hookPlr(p) end
Players.PlayerAdded:Connect(hookPlr)

task.spawn(function()
    while Gui.Parent do
        task.wait(1.5)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then task.spawn(updateGlow, plr.Character, false) end
        end
        if S.EspGlow then
            for m, _ in pairs(npcSet) do
                task.spawn(updateGlow, m, true)
            end
        end
    end
end)

