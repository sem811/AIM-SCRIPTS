local function getPart(m)
    return m:FindFirstChild(S.HitPart) or m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
end

local function alive(m, h)
    return m.Parent and h and h.Health > 0
end

-- ════════ АИМБОТ: STICKY LOCK — прицел НЕ уходит в бок ════════
-- Логика: как только цель захвачена — она ЗАКРЕПЛЯЕТСЯ, прицел
-- держит именно её до смерти. Никаких прыжков между врагами.
local lockedTarget = nil   -- {part=BasePart, model=Model, hum=Humanoid}

local function acquireTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local center = cam.ViewportSize / 2
    local best, bd = nil, S.FOVRadius

    -- игроки
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character.Parent then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if alive(plr.Character, hum) then
                local part = getPart(plr.Character)
                if part then
                    local okp, pos = pcall(function() return cam:WorldToViewportPoint(part.Position) end)
                    if okp and pos and pos.Z > 0 then
                        local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if d < bd then bd, best = d, part end
                    end
                end
            end
        end
    end

    -- боты
    if S.TargetNPCs then
        for m, h in pairs(npcSet) do
            if not m.Parent then
                npcSet[m] = nil
            elseif alive(m, h) then
                local part = getPart(m)
                if part then
                    local okp, pos = pcall(function() return cam:WorldToViewportPoint(part.Position) end)
                    if okp and pos and pos.Z > 0 then
                        local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if d < bd then bd, best = d, part end
                    end
                end
            end
        end
    end
    return best
end

local function targetValid(t)
    if not t or not t.part or not t.part.Parent then return false end
    local hum = t.model and t.model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local cam = Workspace.CurrentCamera
    if not cam then return false end
    local okp, pos = pcall(function() return cam:WorldToViewportPoint(t.part.Position) end)
    if not (okp and pos and pos.Z > 0) then return false end
    -- если цель сильно ушла от центра (больше 2x FOV) — отпускаем
    local center = cam.ViewportSize / 2
    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
    return d < S.FOVRadius * 2.5
end

local frame = 0
RunService.RenderStepped:Connect(function()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    frame = frame + 1

    -- АИМБОТ
    if S.Aimbot then
        -- липкий лок
        if S.StickyLock and lockedTarget and targetValid(lockedTarget) then
            -- держим текущую
        else
            local part = acquireTarget()
            if part then
                local model = part:FindFirstAncestorOfClass("Model")
                lockedTarget = {part = part, model = model, hum = model and model:FindFirstChildOfClass("Humanoid")}
            else
                lockedTarget = nil
            end
        end

        if lockedTarget and lockedTarget.part then
            -- МГНОВЕННЫЙ захват: камера жёстко смотрит в голову —
            -- прицел не плывёт и не уходит в бок
            if S.Snap >= 0.95 then
                cam.CFrame = CFrame.new(cam.CFrame.Position, lockedTarget.part.Position)
            else
                cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, lockedTarget.part.Position), S.Snap)
            end
        end
    else
        lockedTarget = nil
    end

    -- FOV круг
    if frame % 6 == 0 and fovC then
        fovC.Position = cam.ViewportSize / 2
        fovC.Radius = S.FOVRadius
        fovC.Visible = S.ShowFOV and S.Aimbot
    end

    -- боксы ESP
    if frame % 3 ~= 0 then return end
    local camPos = cam.CFrame.Position
    local espShown = 0

    -- игроки
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local d = getD(plr)
        local ch = plr.Character
        local drawn = false
        if ch and ch.Parent and S.EspBoxes then
            local hum = ch:FindFirstChildOfClass("Humanoid")
            local hrp = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("UpperTorso")
            if hum and hum.Health > 0 and hrp then
                local dist = (hrp.Position - camPos).Magnitude
                local okR, rp = pcall(function() return cam:WorldToViewportPoint(hrp.Position) end)
                if okR and rp and rp.Z > 0 then
                    local head = ch:FindFirstChild("Head")
                    local topOk, top = pcall(function() return cam:WorldToViewportPoint((head or hrp).Position + Vector3.new(0, 0.9, 0)) end)
                    local botOk, bot = pcall(function() return cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.1, 0)) end)
                    if topOk and botOk then
                        local h = math.abs(bot.Y - top.Y)
                        if h > 4 then
                            local w = math.max(h * 0.55, 10)
                            local x = rp.X - w/2
                            local y = math.min(top.Y, bot.Y)
                            local col = rgb(255,60,60)
                            drawn = true espShown = espShown + 1
                            if d.box then d.box.Size = Vector2.new(w,h) d.box.Position = Vector2.new(x,y) d.box.Color = col d.box.Visible = true end
                            if d.boxO then d.boxO.Size = Vector2.new(w,h) d.boxO.Position = Vector2.new(x,y) d.boxO.Visible = true end
                            if d.nm then d.nm.Text = plr.Name d.nm.Position = Vector2.new(rp.X, y-18) d.nm.Color = col d.nm.Visible = true end
                            if d.dist then d.dist.Text = math.floor(dist+0.5).."m" d.dist.Position = Vector2.new(rp.X, y+h+4) d.dist.Visible = true end
                            if d.hp and d.hpO then
                                local fr = math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
                                d.hpO.Size = Vector2.new(5,h+2) d.hpO.Position = Vector2.new(x-9,y-1) d.hpO.Visible = true
                                d.hp.Size = Vector2.new(3,h*fr) d.hp.Position = Vector2.new(x-8,y+h*(1-fr)) d.hp.Color = hpCol(fr) d.hp.Visible = true
                            end
                        end
                    end
                end
            end
        end
        if not drawn then hideD(d) end
    end

    -- боты
    for m, h in pairs(npcSet) do
        if not m.Parent then
            npcSet[m] = nil
            local d = espDraw["npc_"..m:GetDebugId()]
            if d then hideD(d) end
        else
            local key = "npc_"..tostring(m)
            local d = getD(key)
            local drawn = false
            if S.EspBoxes and alive(m, h) then
                local part = getPart(m)
                if part then
                    local dist = (part.Position - camPos).Magnitude
                    local okR, rp = pcall(function() return cam:WorldToViewportPoint(part.Position) end)
                    if okR and rp and rp.Z > 0 then
                        local okT, top = pcall(function() return cam:WorldToViewportPoint(part.Position + Vector3.new(0, 2.2, 0)) end)
                        local okB, bot = pcall(function() return cam:WorldToViewportPoint(part.Position - Vector3.new(0, 3.1, 0)) end)
                        if okT and okB then
                            local bh = math.abs(bot.Y - top.Y)
                            if bh > 4 then
                                local w = math.max(bh * 0.55, 10)
                                local x = rp.X - w/2
                                local y = math.min(top.Y, bot.Y)
                                local col = rgb(255,150,40) -- боты оранжевые
                                drawn = true espShown = espShown + 1
                                if d.box then d.box.Size = Vector2.new(w,bh) d.box.Position = Vector2.new(x,y) d.box.Color = col d.box.Visible = true end
                                if d.boxO then d.boxO.Size = Vector2.new(w,bh) d.boxO.Position = Vector2.new(x,y) d.boxO.Visible = true end
                                if d.nm then d.nm.Text = "[BOT] "..m.Name d.nm.Position = Vector2.new(rp.X, y-18) d.nm.Color = col d.nm.Visible = true end
                                if d.dist then d.dist.Text = math.floor(dist+0.5).."m" d.dist.Position = Vector2.new(rp.X, y+bh+4) d.dist.Visible = true end
                                if d.hp and d.hpO then
                                    local fr = math.clamp(h.Health/math.max(h.MaxHealth,1),0,1)
                                    d.hpO.Size = Vector2.new(5,bh+2) d.hpO.Position = Vector2.new(x-9,y-1) d.hpO.Visible = true
                                    d.hp.Size = Vector2.new(3,bh*fr) d.hp.Position = Vector2.new(x-8,y+bh*(1-fr)) d.hp.Color = hpCol(fr) d.hp.Visible = true
                                end
                            end
                        end
                    end
                end
            end
            if not drawn then hideD(d) end
        end
    end

    if frame % 30 == 0 then
        stEsp.Text = "ESP:" .. espShown
        stEsp.TextColor3 = espShown > 0 and C.ACC or C.GR
    end
end)

