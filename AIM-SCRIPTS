-- LocalScript: StarterPlayer > StarterPlayerScripts
-- Способность "Разведка" на клавише T (или нажатием на панель на телефоне):
-- на время действия подсвечивает врагов и мягко подтягивает прицел к цели в узком конусе.
-- Потом уходит на перезарядку. Все числа настраиваются в CONFIG.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local CONFIG = {
	Key = Enum.KeyCode.T,
	Duration = 8, -- сколько секунд действует способность
	Cooldown = 20, -- перезарядка в секундах
	Range = 150, -- дальность в стадах
	ConeAngle = 20, -- половина угла конуса притяжения в градусах
	Strength = 0.3, -- сила помощи 0.05..1 (меняется ползунком)
}

local active = false
local activeUntil = 0
local readyAt = 0

----------------------------------------------------------------
-- Цели
----------------------------------------------------------------
local function isEnemy(plr)
	if plr == player then
		return false
	end
	if player.Team ~= nil and plr.Team == player.Team then
		return false
	end
	return true
end

local function getEnemyCharacters()
	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		if char and isEnemy(plr) then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				table.insert(list, char)
			end
		end
	end
	return list
end

----------------------------------------------------------------
-- Подсветка
----------------------------------------------------------------
local highlights = {}

local function updateHighlights()
	local want = {}
	if active then
		for _, char in ipairs(getEnemyCharacters()) do
			want[char] = true
		end
	end

	for char, h in pairs(highlights) do
		if not want[char] or not char.Parent or not h.Parent then
			h:Destroy()
			highlights[char] = nil
		end
	end

	for char in pairs(want) do
		if not highlights[char] then
			local h = Instance.new("Highlight")
			h.FillColor = Color3.fromRGB(255, 200, 60)
			h.OutlineColor = Color3.fromRGB(255, 255, 255)
			h.FillTransparency = 0.6
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Parent = char
			highlights[char] = h
		end
	end
end

task.spawn(function()
	while true do
		updateHighlights()
		task.wait(0.5)
	end
end)

----------------------------------------------------------------
-- Мягкая помощь прицелу
----------------------------------------------------------------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true

local function isVisible(cam, part, char)
	local ignore = { char, cam }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	rayParams.FilterDescendantsInstances = ignore
	local origin = cam.CFrame.Position
	return Workspace:Raycast(origin, part.Position - origin, rayParams) == nil
end

local function findAssistTarget(cam)
	local camPos = cam.CFrame.Position
	local look = cam.CFrame.LookVector
	local best, bestAngle = nil, CONFIG.ConeAngle

	for _, char in ipairs(getEnemyCharacters()) do
		local part = char:FindFirstChild("UpperTorso")
			or char:FindFirstChild("Torso")
			or char:FindFirstChild("HumanoidRootPart")
		if part then
			local offset = part.Position - camPos
			local dist = offset.Magnitude
			if dist > 0.1 and dist <= CONFIG.Range then
				local dot = math.clamp(look:Dot(offset.Unit), -1, 1)
				local angle = math.deg(math.acos(dot))
				if angle < bestAngle and isVisible(cam, part, char) then
					best = part
					bestAngle = angle
				end
			end
		end
	end

	return best
end

